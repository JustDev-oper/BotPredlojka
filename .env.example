# Telegram Bot Token (aliases: API_TOKEN, TELEGRAM_BOT_TOKEN)
BOT_TOKEN=your_telegram_bot_token_here

# Owner ID (numeric Telegram user id)
OWNER_ID=5877007064

# Data storage path (persistent storage)
# For Docker deployment use: /app/data
# For local development use: ./data
DATA_PATH=./data

# Database configuration (sqlite file inside DATA_PATH)
# DATABASE_PATH or DB_PATH or DATABASE_FILE
DATABASE_PATH=./data/bot.db

# Admin Chat ID (where moderation messages are sent)
ADMIN_CHAT_ID=your_admin_chat_id

# Debug mode (true/false)
DEBUG=False
