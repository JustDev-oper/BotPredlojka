# Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token_here

# Owner ID
OWNER_ID=5877007064

# Data storage path (for persistent data in Docker)
# Use /app/data for Docker deployment
# Use ./data for local development
DATA_PATH=/app/data

# Database configuration
# Path will be: ${DATA_PATH}/bot.db
DATABASE_PATH=/app/data/bot.db

# Admin Chat ID (for notifications)
ADMIN_CHAT_ID=your_admin_chat_id

# Debug mode
DEBUG=False


